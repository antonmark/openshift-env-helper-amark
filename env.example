# Host-specific overrides for this repo.
# Copy to .env on the hypervisor and edit for that host:
#   cp env.example .env
#
# .env is gitignored. The Makefile loads it with `-include .env` (Make syntax).
# .env is NOT a shell dotenv file — use KEY = value (spaces around =).
# Use `export` for values scripts/ssh inherit.
#
# Secrets (RHN_USERNAME / RHN_PASSWORD): set in the shell or in .env if you must;
# never commit them. Prefer:
#   export RHN_PROMPT=false RHN_USERNAME=... RHN_PASSWORD=...
#   make all

# -----------------------------------------------------------------------------
# Per-host values (ocs1–ocs4)
# -----------------------------------------------------------------------------
# Hypervisor          CLUSTER_NAME   CLUSTER_DOMAIN     API example
# ocs1.*.redhat.com   libvirt1       ocpcluster.cc      api.libvirt1.ocpcluster.cc
# ocs2.*.redhat.com   libvirt2       ocpcluster.cc      api.libvirt2.ocpcluster.cc
# ocs3.*.redhat.com   libvirt3       ocpcluster.cc      api.libvirt3.ocpcluster.cc
# ocs4.*.redhat.com   libvirt4       ocpcluster.cc      api.libvirt4.ocpcluster.cc
#
# NETWORK_NAME / NETWORK_CIDR are usually the same on each box (isolated KVM).
# Change them only if this host already uses a conflicting libvirt network.

# --- required per host (pick the row for this machine) ---
export CLUSTER_NAME = libvirt1
export CLUSTER_DOMAIN = ocpcluster.cc

# --- usually unchanged ---
export NETWORK_NAME = openshift4
export NETWORK_CIDR = 192.168.7
OCP_VERSION = 4.14
WORKER_NUM = 2
ODF_NUM = 3
export INSTALL_ODF = true
HELPER_ISO = rhel-8-x86_64-dvd.iso

# --- optional ---
# export DEBUG = true
# export RHN_PROMPT = false
# export RHN_USERNAME = myuser
# export RHN_PASSWORD = mypass
